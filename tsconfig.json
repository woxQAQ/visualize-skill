{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "lib": ["ES2023", "ES2022.Intl", "DOM"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true
  },
  "include": ["src/**/*.ts", "examples/**/*.ts", "src/templates/*.js"]
}
