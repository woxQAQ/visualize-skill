{
  "name": "visualize-skills",
  "version": "0.1.0",
  "private": true,
  "description": "Generate standalone or embeddable interactive architecture, sequence and swimlane diagrams.",
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "example": "node examples/architecture.ts",
    "example:swimlane": "node examples/swimlane.ts",
    "example:sequence": "node examples/sequence.ts",
    "examples": "for f in examples/*.ts; do node \"$f\"; done"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.18.0"
}
